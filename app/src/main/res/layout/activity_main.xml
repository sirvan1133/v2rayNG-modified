<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <com.v2ray.ang.ui.CinematicWorldMapView
            android:id="@+id/cinematic_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:alpha="0.92" />

        <com.v2ray.ang.weather.CinematicWeatherView
            android:id="@+id/cinematic_weather"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:importantForAccessibility="no"
            android:alpha="0" />

        <com.v2ray.ang.market.MarketRatesView
            android:id="@+id/market_rates"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/layout_traffic"
                android:layoutDirection="ltr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_traffic_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Traffic"
                        android:textSize="12sp"
                        android:textColor="#8CFFFFFF" />

                    <TextView
                        android:id="@+id/tv_traffic_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#EBFFFFFF" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/tg_traffic_track">

                    <View
                        android:id="@+id/traffic_progress_fill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@color/tg_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_traffic_used"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 B"
                        android:textSize="11sp"
                        android:textColor="#73FFFFFF" />

                    <TextView
                        android:id="@+id/tv_traffic_remaining"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="0 B"
                        android:textSize="11sp"
                        android:textColor="#73FFFFFF" />

                    <TextView
                        android:id="@+id/tv_traffic_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="0 B"
                        android:textSize="11sp"
                        android:textColor="#73FFFFFF" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_traffic_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text=""
                    android:textSize="10sp"
                    android:textColor="@color/md_theme_onSecondaryContainer"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:liftOnScroll="false">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    android:elevation="0dp"
                    app:titleTextColor="@color/tg_onSurface"
                    app:contentInsetStart="0dp"
                    app:contentInsetLeft="0dp"
                    app:contentInsetRight="0dp"
                    app:contentInsetEnd="0dp">

<LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_top_actions_solid"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="5dp">

                        <TextView
                            android:id="@+id/btn_update_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="@string/title_update_subscription"
                            android:textSize="11sp"
                            android:textColor="@color/tg_primary"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_auto_connect"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="9dp"
                            android:text="@string/auto_connect"
                            android:textSize="10sp"
                            android:textColor="@color/tg_primary"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_add_clipboard"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="9dp"
                            android:text="@string/title_add_from_clipboard"
                            android:textSize="11sp"
                            android:textColor="@color/tg_primary"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_add_config"
                            android:layout_width="42dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="+"
                            android:textSize="25sp"
                            android:textColor="@color/tg_primary"
                            android:fontFamily="sans-serif-medium"
                            android:contentDescription="@string/menu_item_add_config"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>
                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.AppBarLayout>

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="invisible"
                        app:indicatorColor="@color/tg_primary"
                        app:trackColor="@color/tg_outlineVariant" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_sub_groups"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginTop="4dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none"
                        android:paddingVertical="4dp" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:background="@android:color/transparent"
                        android:nextFocusRight="@+id/fab_toggle"
                        android:scrollbars="vertical"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/layout_test"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/view_height_dp64"
                        android:clickable="true"
                        android:contentDescription="@string/connection_test_pending"
                        android:focusable="true"
                        android:nextFocusLeft="@+id/view_pager"
                        android:nextFocusRight="@+id/fab_toggle"
                        android:orientation="vertical">

                        <View
                            android:layout_width="wrap_content"
                            android:layout_height="1dp"
                            android:background="@color/divider_color_light" />

                        <TextView
                            android:id="@+id/tv_test_state"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="start|center"
                            android:maxLines="2"
                            android:minLines="1"
                            android:paddingStart="@dimen/padding_spacing_dp16"
                            android:text="@string/connection_test_pending"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small" />

                    </LinearLayout>

                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp">

                    <WebView
                        android:id="@+id/fab_toggle"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:layerType="software"
                        android:overScrollMode="never"
                        android:contentDescription="@string/tasker_start_service" />

                </FrameLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>

        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/tg_background"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_drawer"
        app:itemTextColor="@color/telegram_drawer_item_color"
        app:itemIconTint="@color/telegram_drawer_item_color"
        app:itemShapeAppearance="@style/TgDrawerItemShape"
        app:itemShapeAppearanceOverlay="@style/TgDrawerItemShape"
        app:itemShapeFillColor="@android:color/transparent"
        app:itemTextAppearance="@style/TgDrawerItemText"
        app:itemPaddingBottom="2dp"
        app:itemPaddingTop="2dp" />

</androidx.drawerlayout.widget.DrawerLayout>
