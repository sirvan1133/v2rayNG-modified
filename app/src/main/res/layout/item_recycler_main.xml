<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_bg"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <View
        android:id="@+id/selection_glow"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginHorizontal="7dp"
        android:alpha="0"
        android:background="@drawable/bg_selected_outer_glow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/info_container"
        android:layoutDirection="ltr"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/bg_server_card_glass"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="true"
        android:paddingHorizontal="7dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/selection_glow"
        app:layout_constraintTop_toTopOf="@id/selection_glow">

        <View
            android:id="@+id/layout_indicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subscription"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_server_flag_glass"
            android:elevation="1dp"
            android:gravity="center"
            android:textSize="22sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="🇩🇪" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/tg_onSurface"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tv_type"
            app:layout_constraintStart_toEndOf="@id/tv_subscription"
            app:layout_constraintTop_toTopOf="@id/tv_subscription"
            tools:text="Premium Server #1" />

        <TextView
            android:id="@+id/tv_statistics"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#8CFFFFFF"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@id/layout_more"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="185.234.10.5 : 443" />

        <View
            android:id="@+id/status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_live_ping_dot"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_statistics" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="Checking…"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@id/status_dot"
            app:layout_constraintStart_toEndOf="@id/status_dot"
            app:layout_constraintTop_toTopOf="@id/status_dot" />

        <TextView
            android:id="@+id/tv_test_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="#65D1FF"
            android:textSize="10sp"
            app:layout_constraintEnd_toStartOf="@id/layout_more"
            app:layout_constraintBottom_toBottomOf="@id/tv_status"
            app:layout_constraintStart_toEndOf="@id/tv_status"
            app:layout_constraintTop_toTopOf="@id/tv_status"
            tools:text="42 ms" />

        <TextView
            android:id="@+id/tv_country"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#66FFFFFF"
            android:textSize="9sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_name"
            app:layout_constraintEnd_toStartOf="@id/layout_more"
            app:layout_constraintStart_toEndOf="@id/tv_name"
            tools:text="VLESS" />

        <LinearLayout
            android:id="@+id/layout_more"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/notification_action_more"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                app:srcCompat="@drawable/ic_more_vert_24dp"
                app:tint="@color/tg_onSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_share"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_edit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layout_remove"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
